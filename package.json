{
  "name": "moki",
  "version": "0.1.0",
  "private": true,
  "description": "A personal assistant for exploring memory, context, and large MCP tool catalogs",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/electron/main.cjs",
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": "1.4.0"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "test:foundation": "bun test tests/foundation.test.ts",
    "desktop": "electron .",
    "dev": "bun scripts/dev.ts",
    "smoke:electron": "bun run scripts/electron-smoke.ts",
    "build:dev": "bun scripts/build.ts --dev",
    "package:dir": "bun run build && electron-builder --dir --publish never",
    "package:mac": "bun run build && electron-builder --mac dmg --publish never"
  },
  "dependencies": {
    "@capekai/core": "1.0.13",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@typesafe-ai/sdk": "^0.5.7",
    "ai": "^6.0.116",
    "electron-updater": "^6.6.2",
    "js-tiktoken": "^1.0.21",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "turndown": "^7.2.4",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/turndown": "^5.0.6",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^40.0.0",
    "electron-builder": "^26.0.0",
    "happy-dom": "^20.14.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.0",
    "vite": "^8.3.0"
  },
  "trustedDependencies": ["electron"],
  "build": {
    "appId": "app.moki.desktop",
    "productName": "Moki",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": ["dist/electron/**", "dist/renderer/**", "package.json"],
    "publish": [{
      "provider": "github",
      "owner": "capek-dev",
      "repo": "moki",
      "releaseType": "release"
    }],
    "extraResources": [{
      "from": "dist/backend/moki-runtime",
      "to": "backend/moki-runtime"
    }, {
      "from": "dist/native/moki-dictate",
      "to": "native/moki-dictate"
    }],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "target": ["dmg", "zip"],
      "identity": null,
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": false,
      "extendInfo": {
        "NSScreenCaptureUsageDescription": "Moki captures a screen region only when you choose Capture region.",
        "NSMicrophoneUsageDescription": "Moki uses the microphone only while you hold the dictate button.",
        "NSSpeechRecognitionUsageDescription": "Moki converts your speech to text so you can dictate messages."
      }
    }
  }
}
